rules_version = '2';

// Beveiligingsregels voor Weekmenu.
// Toegang tot een gezin heeft enkel wie de (lange, willekeurige) gezinscode kent; er is geen lijst van gezinnen op te vragen.
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{hid} {
      allow read, write: if request.auth != null && hid.size() == 16;
    }
    match /households/{hid}/{sub=**} {
      allow read, write: if request.auth != null && hid.size() == 16;
    }
  }
}
